APP_NAME=Invoice Keeper
APP_TIMEZONE=Europe/Moscow
# Local development container: host port 55432 -> PostgreSQL 5432.
DATABASE_URL=postgresql+asyncpg://invoice_keeper:replace_me@127.0.0.1:55432/invoice_keeper
APP_ENV=development
SESSION_COOKIE_NAME=invoice_keeper_session
# Set true behind HTTPS. APP_ENV=production enforces this and HTTPS origins.
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_IP_ATTEMPTS=60
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
