APP_NAME=Invoice Keeper
APP_TIMEZONE=Europe/Moscow
# Compose PostgreSQL: set the host port from the root POSTGRES_PORT setting.
DATABASE_URL=postgresql+asyncpg://invoice_keeper:replace_me@127.0.0.1:5432/invoice_keeper
# Initial administrator: used only by `python -m app.cli create-admin`.
# Set your own 8-128 character password. Never commit the working .env.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
APP_ENV=development
SESSION_COOKIE_NAME=session_id
# Set true behind HTTPS. APP_ENV=production enforces this and HTTPS origins.
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_IP_ATTEMPTS=60
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
PASSWORD_CHANGE_RATE_LIMIT_ATTEMPTS=5
PASSWORD_CHANGE_RATE_LIMIT_WINDOW_SECONDS=900
# Telegram delivery: worker reminders and backend personal MFA codes.
# Do not copy real tokens into tracked files.
BOT_TOKEN=
# Reminders only. Personal MFA always uses the confirmed private Telegram account.
CHAT_ID=
# Actual bot username without @, for personal linking URLs.
BOT_USERNAME=
# Separate high-entropy secret shared with the bot's internal bridge client.
BOT_INTERNAL_TOKEN=
# Persistent Fernet key; save separately from the database backup.
MFA_ENCRYPTION_KEY=
