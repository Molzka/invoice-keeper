{
	default_sni {$TLS_DEFAULT_NAME}
	servers {
		protocols h1 h2
	}
}

https://{$PUBLIC_HOST} {$HTTPS_ALIASES} {
	tls {
		issuer acme {
			profile shortlived
		}
	}

	@alias not host {$PUBLIC_HOST}
	redir @alias https://{$PUBLIC_HOST}{uri} permanent

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		-Server
	}

	# Caddy is the public API proxy: it sets the actual client address and HTTPS scheme.
	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:8080
	}

	handle_errors {
		header Content-Type application/json
		header Cache-Control no-store
		respond "{\"error\":{\"code\":\"API_NOT_AVAILABLE\",\"message\":\"Service temporarily unavailable\",\"details\":[]}}" 503
	}
}
