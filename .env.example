# Copy this file to .env once. Never commit .env.
POSTGRES_DB=invoice_keeper
POSTGRES_USER=invoice_keeper
# Required: set a unique local password before starting Compose.
# Single quotes preserve special characters, for example: 'your-long-password'
POSTGRES_PASSWORD=
# Host port only; containers connect to postgres:5432.
POSTGRES_PORT=5432

# Frontend address: http://localhost:8080
FRONTEND_PORT=8080
# Use the real API and PostgreSQL. Set mock only for the standalone UI demo.
# Rebuild frontend after changing this value.
FRONTEND_API_MODE=real

# Backend in Compose reads this root .env; backend/.env is only for running uv locally.
APP_ENV=development
SESSION_COOKIE_SECURE=false
PASSWORD_CHANGE_RATE_LIMIT_ATTEMPTS=5
PASSWORD_CHANGE_RATE_LIMIT_WINDOW_SECONDS=900
# Defaults to localhost and 127.0.0.1 with FRONTEND_PORT; override for a different origin.
# ALLOWED_ORIGINS='["http://localhost:8080","http://127.0.0.1:8080"]'
# Used by the explicit create-admin command, not automatically on API startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional personal Telegram ID of this administrator; configured only on the server.
ADMIN_TELEGRAM_ID=

# Application calendar timezone. PostgreSQL itself uses UTC.
APP_TIMEZONE=Europe/Moscow

# Required when starting bot (or all services). Get the token from @BotFather.
BOT_TOKEN=
# Actual username from BotFather, without @. Required for MFA and payment linking.
BOT_USERNAME=
# Separate random service secret shared only by backend and bot; not API_PASSWORD.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_INTERNAL_TOKEN=
# Personal linking uses this internal origin, independently of the financial API account.
BOT_INTERNAL_BASE_URL=http://backend:8000
# Backend-only Fernet key for MFA secrets. Keep a separate safe backup; never regenerate on restart.
# Generate with: uv run --project backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
# Destination for reminders. /id shows the ID of the chat where it is called.
CHAT_ID=
# Worker checks payment periods and the reminder queue at this interval (seconds, >= 1).
REMINDER_POLL_SECONDS=30
# Optional full http(s) URL for /site, reachable from Telegram users' devices.
PANEL_URL=

# Optional for public bot commands; required for /payments and /overdue.
# Create a separate ordinary user in the web interface. Do not use the administrator.
# Personal Telegram linking does not use this account. Enabling MFA on it prevents unattended login.
# Docker uses this internal API address; a host-run smoke command must use the site address.
API_BASE_URL=http://backend:8000/api/v1
API_USERNAME=telegram_bot
API_PASSWORD=
# Must match one of the backend's ALLOWED_ORIGINS. Default follows FRONTEND_PORT.
# API_ORIGIN=http://localhost:8080
API_TIMEOUT=10
