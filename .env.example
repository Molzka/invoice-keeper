# Copy this file to .env once. Never commit .env.
POSTGRES_DB=invoice_keeper
POSTGRES_USER=invoice_keeper
# Required: set a unique local password before starting Compose.
# Single quotes preserve special characters, for example: 'your-long-password'
POSTGRES_PASSWORD=
# Host port only; containers connect to postgres:5432.
POSTGRES_PORT=5432

# Frontend address: http://localhost:8080
FRONTEND_PORT=8080

# Reserved for the application. PostgreSQL itself uses UTC.
APP_TIMEZONE=Europe/Moscow

# Required when starting bot (or all services). Get the token from @BotFather.
BOT_TOKEN=
# Destination for reminders. /id shows the ID of the chat where it is called.
CHAT_ID=
