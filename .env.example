# Copy this file to .env once. Never commit .env.
POSTGRES_DB=invoice_keeper
POSTGRES_USER=invoice_keeper
# Required: set a unique local password before starting Compose.
# Single quotes preserve special characters, for example: 'your-long-password'
POSTGRES_PASSWORD=
# Host port only; containers connect to postgres:5432.
POSTGRES_PORT=5432

# Frontend address: http://localhost:8080
FRONTEND_PORT=8080
# Keep mock until the payments API is ready. Rebuild frontend after changing.
FRONTEND_API_MODE=mock

# Backend in Compose reads this root .env; backend/.env is only for running uv locally.
APP_ENV=development
SESSION_COOKIE_SECURE=false
# Defaults to localhost and 127.0.0.1 with FRONTEND_PORT; override for a different origin.
# ALLOWED_ORIGINS='["http://localhost:8080","http://127.0.0.1:8080"]'
# Used by the explicit create-admin command, not automatically on API startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Application calendar timezone. PostgreSQL itself uses UTC.
APP_TIMEZONE=Europe/Moscow

# Required when starting bot (or all services). Get the token from @BotFather.
BOT_TOKEN=
# Destination for reminders. /id shows the ID of the chat where it is called.
CHAT_ID=
